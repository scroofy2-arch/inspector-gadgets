# Seeking Tools — Firebase config
# Copy this file to `.env.local` and fill in the values from the Firebase console
# (Project settings > Your apps > Web app). Do NOT commit `.env.local`.
#
# These are public web-app identifiers, not secrets — but keep them out of
# source control anyway. The app shows a setup screen until they are set.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: score-based reCAPTCHA Enterprise site key for App Check (production).
# Leave blank in local dev — the debug provider is used instead (see README).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional: reuse a registered App Check debug token. Set to "false" to turn
# the debug provider off. Only honoured in dev.
VITE_APPCHECK_DEBUG_TOKEN=
